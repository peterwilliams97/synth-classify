.venv/
__pycache__/

# Downloads, exports and model outputs; the generated training sets are the tracked artifacts.
data/*/*
!data/*/synthetic.jsonl
!data/*/synthetic-*.jsonl
!data/*/synthetic-*.prompt.txt
# The real train split minus dev, behind the ultrabert-embed-real-nodev reports.
!data/*/banking77_train_nodev.jsonl
# Its stratified subsets, behind the ultrabert-embed-real-nodev-<n> label curve.
!data/*/banking77_train_nodev_*.jsonl
models/
